    {
      "id": 6,
      "change_id": "27e60eb4-e4f8-479d-ae39-ce11d5449f41",
      "node_type": "decision",
      "title": "UX for auto-computed vs server-propagated dates",
      "description": null,
      "status": "pending",
      "created_at": "2026-02-16T17:35:13.150791104-05:00",
      "updated_at": "2026-02-16T17:35:13.150791104-05:00",
      "metadata_json": "{\"branch\":\"hw\",\"confidence\":50,\"prompt\":\"User discovered that HW server-side date propagation restores dates on dependent issues after deletion. The 'auto' badge (dateSource=computed) only covers client-side CPM virtual dates, not server-propagated ones. Showing 'computed' after user deletes dates is arguably misleading — CPM fills them back in immediately. No backend flag exists to distinguish server-propagated from manually-set dates. Options: (1) suppress computed dates after user clears, (2) debounce computed injection until server round-trip, (3) improve messaging (e.g. 'dates calculated from dependencies'), (4) leave as-is. Parked for discussion with team.\"}"
    },
    {
      "id": 7,
      "change_id": "265a14da-70f1-476c-8930-0b0fe19b20a0",
      "node_type": "observation",
      "title": "Server-side date propagation has no client-detectable flag",
      "description": null,
      "status": "pending",
      "created_at": "2026-02-16T17:35:20.481394397-05:00",
      "updated_at": "2026-02-16T17:35:20.481394397-05:00",
      "metadata_json": "{\"branch\":\"hw\",\"confidence\":90,\"prompt\":\"Grepped for date_propagated, is_propagated, auto_date, date_source — nothing. Server propagation sets real start_date/target_date on dependent issues, indistinguishable from manual dates on the client. Any client-side heuristic (compare with CPM ES/EF, check for blocking relations) would be fragile.\"}"
    },
