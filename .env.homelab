
# Plane Homelab Deployment
# Copy to .env.homelab and fill in ALL values marked CHANGEME
#
# Generate secrets:
#   openssl rand -hex 32    (for SECRET_KEY, LIVE_SERVER_SECRET_KEY)
#   pwgen -s 32 1           (for passwords)
#   pwgen -s 20 1           (for AWS_ACCESS_KEY_ID)
#   pwgen -s 40 1           (for AWS_SECRET_ACCESS_KEY)

# ----- Domain -----
# Your Cloudflare tunnel hostname (no protocol)
APP_DOMAIN=project.radiant-industries.space
# Full URL including protocol
WEB_URL=https://project.radiant-industries.space

# ----- Django -----
SECRET_KEY=e0f1cef8314dd8bc5b53cafff6f9713c324ba9a6c5bb308f04f7a9e5fbf750fe

# ----- PostgreSQL -----
POSTGRES_USER=plane
POSTGRES_PASSWORD=mRsvaoxnTVwNBwoOFRwl3A1fF5ZyIRDj
POSTGRES_DB=plane

# ----- Redis -----
# No auth needed — not exposed outside the compose network

# ----- RabbitMQ -----
RABBITMQ_USER=plane
RABBITMQ_PASSWORD=H6oEP5dbGy1pDAJJGg5utox97El7wJh6
RABBITMQ_VHOST=plane

# ----- MinIO (S3-compatible object storage) -----
