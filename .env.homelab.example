# Plane Homelab Deployment
# Copy to .env.homelab and fill in ALL values marked CHANGEME
#
# Generate secrets:
#   openssl rand -hex 32    (for SECRET_KEY, LIVE_SERVER_SECRET_KEY)
#   pwgen -s 32 1           (for passwords)
#   pwgen -s 20 1           (for AWS_ACCESS_KEY_ID)
#   pwgen -s 40 1           (for AWS_SECRET_ACCESS_KEY)

# ----- Domain -----
# Your Cloudflare tunnel hostname (no protocol)
APP_DOMAIN=plane.example.com
# Full URL including protocol
WEB_URL=https://plane.example.com

# ----- Django -----
SECRET_KEY=CHANGEME

# ----- PostgreSQL -----
POSTGRES_USER=plane
POSTGRES_PASSWORD=CHANGEME
POSTGRES_DB=plane

# ----- Redis -----
# No auth needed — not exposed outside the compose network

# ----- RabbitMQ -----
RABBITMQ_USER=plane
RABBITMQ_PASSWORD=CHANGEME
RABBITMQ_VHOST=plane

# ----- MinIO (S3-compatible object storage) -----
AWS_ACCESS_KEY_ID=CHANGEME
AWS_SECRET_ACCESS_KEY=CHANGEME

# ----- Live collaboration -----
LIVE_SERVER_SECRET_KEY=CHANGEME

# ----- Tuning (defaults are fine for a small team) -----
# FILE_SIZE_LIMIT=5242880
# API_KEY_RATE_LIMIT=60/minute
